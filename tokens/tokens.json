{
  "$schema": "https://style-dictionary-utils.inlang.com",
  "color": {
    "brand": {
      "blue":            { "$value": "#133B62", "$type": "color", "usage": "Main primary brand color" },
      "blueLight":       { "$value": "#0069AA", "$type": "color", "usage": "Buttons, menus, badges" },
      "bluePale":        { "$value": "#B6C7D7", "$type": "color", "usage": "Icons in light contexts" },
      "green":           { "$value": "#42820D", "$type": "color", "usage": "Buttons, menus, badges" },
      "greenLight":      { "$value": "#7AC043", "$type": "color", "usage": "Icons" },
      "greenProgress":   { "$value": "#5E9732", "$type": "color", "usage": "Progress bar" },
      "gray":            { "$value": "#555555", "$type": "color", "usage": "Body text" },
      "grayBackground":  { "$value": "#EDEDF2", "$type": "color", "usage": "Main page background" },
      "grayFooter":      { "$value": "#333333", "$type": "color", "usage": "Footer background" }
    },
    "semantic": {
      "error":   { "$value": "#D32F2F", "$type": "color", "usage": "Error states, destructive actions" },
      "warning": { "$value": "#F57C00", "$type": "color", "usage": "Warnings" },
      "caution": { "$value": "#FFB300", "$type": "color", "usage": "Caution / attention" },
      "success": { "$value": "#388E3C", "$type": "color", "usage": "Success states" },
      "info":    { "$value": "#0288D1", "$type": "color", "usage": "Informational messages" }
    },
    "base": {
      "white": { "$value": "#FFFFFF", "$type": "color" },
      "black": { "$value": "#000000", "$type": "color" }
    }
  },
  "typography": {
    "fontFamily": {
      "base": { "$value": "Mulish, sans-serif", "$type": "fontFamily" }
    },
    "fontWeight": {
      "light":   { "$value": 300, "$type": "fontWeight" },
      "regular": { "$value": 400, "$type": "fontWeight" },
      "medium":  { "$value": 500, "$type": "fontWeight" },
      "bold":    { "$value": 700, "$type": "fontWeight" }
    },
    "scale": {
      "brandH1": {
        "fontSize":      { "$value": "56px",     "$type": "dimension" },
        "fontWeight":    { "$value": 400,         "$type": "fontWeight" },
        "lineHeight":    { "$value": 1.143,       "$type": "number" },
        "letterSpacing": { "$value": "-1.79%",    "$type": "number" },
        "usage": "Branding display heading – desktop only"
      },
      "h1": {
        "fontSize":      { "$value": "48px",     "$type": "dimension" },
        "fontWeight":    { "$value": 500,         "$type": "fontWeight" },
        "lineHeight":    { "$value": 1.167,       "$type": "number" },
        "letterSpacing": { "$value": "-2.08%",    "$type": "number" },
        "breakpoints":   ["mobile", "tabletPortrait", "tabletLandscape", "desktop"],
        "usage": "Scale 01 – Page and section headings"
      },
      "h2hero": {
        "fontSize":      { "$value": "60px",     "$type": "dimension" },
        "fontWeight":    { "$value": 300,         "$type": "fontWeight" },
        "lineHeight":    { "$value": 1.2,         "$type": "number" },
        "letterSpacing": { "$value": "-0.83%",    "$type": "number" },
        "usage": "Scale 01 variant – Cover/hero display"
      }
    },
    "formElements": {
      "label":       { "scaleRef": "09", "usage": "<label> elements" },
      "value":       { "scaleRef": "10", "usage": "Input field content" },
      "buttonText":  { "scaleRef": "11", "usage": "<button> text" },
      "supportText": { "scaleRef": "12", "usage": "Helper text, error messages, alerts, notifications" },
      "tagText":     { "scaleRef": "13", "usage": "Badge text, chip text, pill text" }
    }
  }
}
